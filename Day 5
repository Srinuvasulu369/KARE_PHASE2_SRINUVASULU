//to count no of digits in the given Number
//logic- n=4862
//        486 c=1
//         48 c=2 
//          4 c=3
//          0 c=4 
import java.util.*;
class Main {
    public static void main(String[] args){
        Scanner obj=new Scanner(System.in);
        int n=obj.nextInt();
        int c=0;
        while(n!=0) 
        {
            n=n/10;
            c++;
        }
            System.out.print(" No of digits:"+c);
        
    }
}
